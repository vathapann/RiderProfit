@page "/shift-planner"
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@inject IShiftPredictor Predictor
<PageTitle>Shift Planner</PageTitle>

<h1>Shift Planner</h1>

<div class="mb-3">
    <label class="form-label">Day</label>
    <select class="form-select" @bind="day">
        @foreach (var d in Enum.GetValues<DayOfWeek>()) // loop through 
        {
            <option value="@d">@d</option>
        }
    </select>
</div>

<div class="mb-3">
    <label class="form-label">Hour</label>
    <select class="form-select" @bind="hour">
        @for (var h = 0 ; h < 24; h++)  
        {
            <option value="@h">@($"{h:00}:00")</option>
        }
    </select>
</div>

<div class="mb-3">
    <label class="form-label">Restaurant suburb</label>
    <select class="form-select" @bind="suburb">
        @foreach (var s in Predictor.KnownSuburbs)
        {
            <option value="@s">@s</option>
        }
    </select>
</div>
<button class="btn btn-primary" @onclick="Predict">Predict</button>

@if(result != null)
{
    <p class="mt-3">Predicted earnings: <strong>$@result.Value.ToString("F2")</strong> per delivery hour</p>
}

<p class="text-muted small mt-3">
    ML model limitation: Predictions are based on a limited dataset and do not account for idle time between orders.
</p>

@code{
    private DayOfWeek day = DayOfWeek.Friday;
    private int hour = 18;
    private string suburb = string.Empty;
    private float? result;
    protected override void OnInitialized()
    {
        suburb = Predictor.KnownSuburbs.FirstOrDefault() ?? string.Empty;
    }
    private void Predict()
    {
        result = Predictor.Predict(day, hour, suburb);
    }

}