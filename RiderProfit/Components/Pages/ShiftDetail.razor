@page "/shift-logging/{ShiftId:int}"
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@using System.ComponentModel.DataAnnotations
@using System.Security.Claims
@using RiderProfit.Services.Import
@* Services that load and save the rider's data *@
@inject IShiftService ShiftService
@inject ITripService TripService
@inject ITripImporter TripImporter

<PageTitle>Shift details</PageTitle>

<a href="shift-logging" class="btn btn-link px-0 mb-2">← Back to shifts</a>

@if (isLoading)
{
    <p><em>Loading...</em></p>
}
else if (shift is null)
{
    <div class="alert alert-warning" role="alert">Shift not found.</div>
}
else
{
    <h1>@shift.Platform?.Name · @shift.StartTime.ToString("ddd d MMM")</h1>
    <p class="text-muted">
        @shift.StartTime.ToString("h:mm tt") – @shift.EndTime.ToString("h:mm tt")
        · @shift.Vehicle?.Make @shift.Vehicle?.Model
    </p>

    @* Summary cards: totals are calculated from the shift's trips *@
    <div class="row g-3 mb-4">
        <div class="col-6 col-md-3">
            <div class="card h-100">
                <div class="card-body">
                    <div class="text-muted small">Earnings</div>
                    <div class="fs-4 fw-semibold">@shift.Earnings.ToString("C")</div>
                </div>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="card h-100">
                <div class="card-body">
                    <div class="text-muted small">Trips</div>
                    <div class="fs-4 fw-semibold">@shift.TripCount</div>
                </div>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="card h-100">
                <div class="card-body">
                    <div class="text-muted small">Distance</div>
                    <div class="fs-4 fw-semibold">@shift.TotalDistanceKm.ToString("0.0") km</div>
                </div>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="card h-100">
                <div class="card-body">
                    <div class="text-muted small">Earnings per hour</div>
                    <div class="fs-4 fw-semibold">@EarningsPerHour.ToString("C")</div>
                </div>
            </div>
        </div>
    </div>

    <h2 class="h5">Trips</h2>

    @* Manual entry: for any platform, and the fallback when screenshot import isn't available *@
    <button type="button" class="btn btn-outline-primary mb-3" @onclick="ToggleTripForm">
        @(showTripForm ? "Close manual entry" : "Add trip manually")
    </button>

    @if (showTripForm)
    {
        <EditForm Model="tripForm" OnValidSubmit="SaveManualTripAsync" FormName="add-trip" class="card card-body mb-4">
            <DataAnnotationsValidator />

            @* Required details *@
            <div class="row g-3">
                <div class="col-sm-6 col-lg-3">
                    <label for="trip-time" class="form-label">Start time</label>
                    <input id="trip-time" type="time" class="form-control" @bind="tripForm.Time" />
                </div>
                <div class="col-sm-6 col-lg-3">
                    <label for="trip-duration" class="form-label">Duration (minutes)</label>
                    <InputNumber id="trip-duration" class="form-control" @bind-Value="tripForm.DurationMinutes" />
                    <ValidationMessage For="() => tripForm.DurationMinutes" class="text-danger" />
                </div>
                <div class="col-sm-6 col-lg-3">
                    <label for="trip-distance" class="form-label">Distance (km)</label>
                    <InputNumber id="trip-distance" class="form-control" @bind-Value="tripForm.DistanceKm" />
                    <ValidationMessage For="() => tripForm.DistanceKm" class="text-danger" />
                </div>
                <div class="col-sm-6 col-lg-3">
                    <label for="trip-earnings" class="form-label">Earnings ($)</label>
                    <InputNumber id="trip-earnings" class="form-control" @bind-Value="tripForm.Earnings" />
                    <ValidationMessage For="() => tripForm.Earnings" class="text-danger" />
                </div>
                <div class="col-sm-6 col-lg-3">
                    <label for="trip-tips" class="form-label">Tips ($)</label>
                    <InputNumber id="trip-tips" class="form-control" @bind-Value="tripForm.Tips" placeholder="0 if none" />
                    <ValidationMessage For="() => tripForm.Tips" class="text-danger" />
                </div>
                <div class="col-sm-6 col-lg-3">
                    <label for="trip-pickup-suburb" class="form-label">Pickup suburb</label>
                    <InputText id="trip-pickup-suburb" class="form-control" @bind-Value="tripForm.PickupSuburb" placeholder="e.g. Miranda" />
                    <ValidationMessage For="() => tripForm.PickupSuburb" class="text-danger" />
                </div>
                <div class="col-sm-6 col-lg-3">
                    <label for="trip-suburb" class="form-label">Drop-off suburb</label>
                    <InputText id="trip-suburb" class="form-control" @bind-Value="tripForm.DropoffSuburb" placeholder="e.g. Caringbah" />
                    <ValidationMessage For="() => tripForm.DropoffSuburb" class="text-danger" />
                </div>
            </div>

            @* Optional details *@
            <div class="row g-3 mt-1">
                <div class="col-sm-6 col-lg-3">
                    <label for="trip-pickup" class="form-label">Pickup name <span class="text-muted">(optional)</span></label>
                    <InputText id="trip-pickup" class="form-control" @bind-Value="tripForm.PickupName" placeholder="e.g. Harris Farm (Miranda)" />
                    <ValidationMessage For="() => tripForm.PickupName" class="text-danger" />
                </div>
                <div class="col-sm-6 col-lg-3">
                    <label for="trip-dropoff" class="form-label">Drop-off street <span class="text-muted">(optional)</span></label>
                    <InputText id="trip-dropoff" class="form-control" @bind-Value="tripForm.DropoffName" placeholder="Street only, no house number" />
                    <ValidationMessage For="() => tripForm.DropoffName" class="text-danger" />
                </div>
            </div>

            <div class="mt-3">
                <button type="submit" class="btn btn-primary">Save trip</button>
            </div>
        </EditForm>
    }

    @* Screenshot import: only for platforms the importer understands, and only when OCR is set up *@
    @if (shift.Platform?.Name == TripImporter.PlatformName)
    {
        @if (!TripImporter.IsAvailable)
        {
            <div class="alert alert-secondary" role="status">
                Screenshot import is unavailable on this machine (Azure AI Vision is not configured).
            </div>
        }
        else if (pendingTrips is null)
        {
            <div class="mb-3">
                <label for="screenshot" class="form-label">Import trips from an Uber Eats "Earnings activity" screenshot</label>
                <InputFile id="screenshot" OnChange="ReadScreenshotAsync" accept="image/png,image/jpeg"
                           class="form-control" disabled="@isReading" />
            </div>
        }

        @if (isReading)
        {
            <p><em>Reading screenshot...</em></p>
        }
    }

    @if (errorMessage is not null)
    {
        <div class="alert alert-danger" role="alert">@errorMessage</div>
    }
    @if (message is not null)
    {
        <div class="alert alert-success" role="status">@message</div>
    }

    @* Review step: the rider checks the trips read from the screenshot before they are saved *@
    @if (pendingTrips is not null)
    {
        <div class="card border-primary mb-4">
            <div class="card-body">
                <h3 class="h6">Check these trips before saving</h3>
                <p class="text-muted small">
                    Remove any trip that was read incorrectly; you can add it manually instead.
                    The screenshot usually shows a restaurant name rather than an address, so fill in the
                    pickup suburb where it's missing. Suburbs help the shift planner learn which areas pay best.
                </p>

                <div class="table-responsive">
                    <table class="table table-sm align-middle">
                        <thead>
                            <tr>
                                <th>Time</th>
                                <th>Pickup</th>
                                <th>Pickup suburb</th>
                                <th>Drop-off</th>
                                <th>Drop-off suburb</th>
                                <th class="text-end">Distance</th>
                                <th class="text-end">Duration</th>
                                <th class="text-end">Earnings</th>
                                <th><span class="visually-hidden">Actions</span></th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var trip in pendingTrips)
                            {
                                <tr>
                                    <td>@trip.StartTime.ToString("h:mm tt")</td>
                                    <td>@trip.PickupName</td>
                                    <td>
                                        @* Editable: the parser can only find it when the pickup is an address *@
                                        <input class="form-control form-control-sm" maxlength="100" placeholder="Add suburb"
                                               aria-label="Pickup suburb for @trip.PickupName" @bind="trip.PickupSuburb" />
                                    </td>
                                    <td>@trip.DropoffName</td>
                                    <td>
                                        <input class="form-control form-control-sm" maxlength="100" placeholder="Add suburb"
                                               aria-label="Drop-off suburb for @trip.DropoffName" @bind="trip.DropoffSuburb" />
                                    </td>
                                    <td class="text-end">@trip.DistanceKm.ToString("0.00") km</td>
                                    <td class="text-end">@((int)trip.Duration.TotalMinutes) min</td>
                                    <td class="text-end">@trip.Earnings.ToString("C")</td>
                                    <td class="text-end">
                                        <button type="button" class="btn btn-sm btn-outline-danger"
                                                @onclick="() => pendingTrips.Remove(trip)">Remove</button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                <button type="button" class="btn btn-primary" @onclick="SavePendingTripsAsync"
                        disabled="@(pendingTrips.Count == 0)">Save @pendingTrips.Count trip(s)</button>
                <button type="button" class="btn btn-outline-secondary ms-2" @onclick="CancelImport">Cancel</button>
            </div>
        </div>
    }

    @if (shift.Trips.Count == 0)
    {
        <p class="text-muted">No trips yet for this shift.</p>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-striped align-middle">
                <thead>
                    <tr>
                        <th>Time</th>
                        <th>Pickup</th>
                        <th>Pickup suburb</th>
                        <th>Drop-off suburb</th>
                        <th class="text-end">Distance</th>
                        <th class="text-end">Earnings</th>
                        <th class="text-end">Tips</th>
                        <th><span class="visually-hidden">Actions</span></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var trip in shift.Trips.OrderBy(t => t.StartTime))
                    {
                        <tr>
                            <td>@trip.StartTime.ToString("h:mm tt")</td>
                            <td>@trip.PickupName</td>
                            <td>@trip.PickupSuburb</td>
                            <td>@trip.DropoffSuburb</td>
                            <td class="text-end">@trip.DistanceKm.ToString("0.0") km</td>
                            <td class="text-end">@trip.Earnings.ToString("C")</td>
                            <td class="text-end">@trip.Tips.ToString("C")</td>
                            <td class="text-end">
                                <button type="button" class="btn btn-sm btn-outline-danger"
                                        @onclick="() => DeleteTripAsync(trip.Id)">Delete</button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
}

@code {
    // Azure AI Vision accepts up to 20 MB; phone screenshots are far smaller
    private const long MaxScreenshotBytes = 10 * 1024 * 1024;

    // Filled from the URL, e.g. /shift-logging/5 → ShiftId = 5
    [Parameter]
    public int ShiftId { get; set; }

    // Provided by AddCascadingAuthenticationState() in Program.cs
    [CascadingParameter]
    private Task<AuthenticationState> AuthState { get; set; } = default!;

    private string? userId;
    private Shift? shift; // includes shift.Trips
    private bool isLoading = true;

    // Trips read from a screenshot that the rider hasn't saved yet; null when not importing
    private List<Trip>? pendingTrips;
    private bool isReading;
    private string? message;
    private string? errorMessage;

    // Earnings and tips divided by the whole shift's hours, including waiting time
    private decimal EarningsPerHour =>
        shift is null || shift.Duration.TotalHours <= 0
            ? 0
            : (shift.Earnings + shift.Tips) / (decimal)shift.Duration.TotalHours;

    protected override async Task OnInitializedAsync()
    {
        var user = (await AuthState).User;
        userId = user.FindFirstValue(ClaimTypes.NameIdentifier);

        await LoadShiftAsync();
        isLoading = false;
    }

    private async Task LoadShiftAsync()
    {
        if (userId is not null)
        {
            // null if the shift doesn't exist or belongs to another rider
            shift = await ShiftService.GetShiftAsync(ShiftId, userId);
        }
    }

    private async Task DeleteTripAsync(int tripId)
    {
        if (userId is null)
        {
            return;
        }

        await TripService.DeleteTripAsync(tripId, userId);
        await LoadShiftAsync();
    }

    // Reads the uploaded screenshot and shows the trips found for review
    private async Task ReadScreenshotAsync(InputFileChangeEventArgs e)
    {
        if (shift is null)
        {
            return;
        }

        message = null;
        errorMessage = null;
        isReading = true;

        try
        {
            await using var stream = e.File.OpenReadStream(MaxScreenshotBytes);
            var trips = await TripImporter.ImportAsync(stream, shift);

            // Screenshots taken while scrolling overlap, so skip trips this shift already has
            var newTrips = trips
                .Where(t => !shift.Trips.Any(existing =>
                    existing.StartTime == t.StartTime && existing.Earnings == t.Earnings))
                .ToList();

            if (newTrips.Count == 0)
            {
                errorMessage = trips.Count == 0
                    ? "No complete trips were found. Make sure the screenshot shows the Uber Eats Earnings activity list."
                    : "All trips in this screenshot are already saved for this shift.";
            }
            else
            {
                pendingTrips = newTrips;
            }
        }
        catch (IOException)
        {
            errorMessage = "The image is too large";
        }
        catch (Azure.RequestFailedException)
        {
            errorMessage = "The screenshot couldn't be read by Azure AI Vision. Please try again.";
        }
        finally
        {
            isReading = false;
        }
    }

    private async Task SavePendingTripsAsync()
    {
        if (pendingTrips is null || pendingTrips.Count == 0)
        {
            return;
        }

        var count = pendingTrips.Count;
        await TripService.AddTripsAsync(pendingTrips);

        pendingTrips = null;
        message = $"{count} trip(s) saved.";
        await LoadShiftAsync();
    }

    private void CancelImport()
    {
        pendingTrips = null;
        message = null;
    }

    // Manual trip entry state
    private bool showTripForm;
    private TripForm tripForm = new TripForm();

    private void ToggleTripForm()
    {
        showTripForm = !showTripForm;
        message = null;
        errorMessage = null;
    }

    // Runs only when every validation rule on the trip form passes
    private async Task SaveManualTripAsync()
    {
        if (shift is null)
        {
            return;
        }

        message = null;
        errorMessage = null;

        var trip = tripForm.ToTrip(shift);

        // A rule involving the shift, which attributes on the form can't check
        if (trip.StartTime < shift.StartTime || trip.StartTime > shift.EndTime)
        {
            errorMessage = $"The trip must start during the shift ({shift.StartTime:h:mm tt} – {shift.EndTime:h:mm tt}).";
            return;
        }

        await TripService.AddTripAsync(trip);

        message = "Trip saved.";
        tripForm = new TripForm { Time = tripForm.Time };
        await LoadShiftAsync();
    }

    // Holds what the rider types in; ToTrip() turns it into a Trip on the shift's date.
    private class TripForm
    {
        public TimeOnly Time { get; set; } = new(18, 0);

        [Required(ErrorMessage = "Enter the trip's duration.")]
        [Range(1, 300, ErrorMessage = "Enter a duration between 1 and 300 minutes.")]
        public int? DurationMinutes { get; set; }

        [Required(ErrorMessage = "Enter the trip's distance.")]
        [Range(0.1, 200, ErrorMessage = "Enter a distance between 0.1 and 200 km.")]
        public decimal? DistanceKm { get; set; }

        [Required(ErrorMessage = "Enter the trip's earnings.")]
        [Range(0.01, 1000, ErrorMessage = "Enter earnings between $0.01 and $1,000.")]
        public decimal? Earnings { get; set; }

        [Required(ErrorMessage = "Enter the tips, or 0 if there were none.")]
        [Range(0, 1000, ErrorMessage = "Tips must be between $0 and $1,000.")]
        public decimal? Tips { get; set; }

        [Required(ErrorMessage = "Enter the pickup suburb."), StringLength(100)]
        public string PickupSuburb { get; set; } = string.Empty;

        [Required(ErrorMessage = "Enter the drop-off suburb."), StringLength(100)]
        public string DropoffSuburb { get; set; } = string.Empty;

        [StringLength(150)]
        public string PickupName { get; set; } = string.Empty;

        [StringLength(150)]
        public string DropoffName { get; set; } = string.Empty;

        public Trip ToTrip(Shift shift)
        {
            // For a shift that runs past midnight, a time earlier than the shift start is on the next day
            var date = shift.StartTime.Date;
            if (shift.EndTime.Date > shift.StartTime.Date && Time.ToTimeSpan() < shift.StartTime.TimeOfDay)
            {
                date = date.AddDays(1);
            }

            var start = date + Time.ToTimeSpan();

            // Only called after validation, so the required numbers have values
            return new Trip
            {
                ShiftId = shift.Id,
                StartTime = start,
                EndTime = start.AddMinutes(DurationMinutes!.Value),
                Earnings = Earnings!.Value,
                Tips = Tips!.Value,
                DistanceKm = DistanceKm!.Value,
                PickupName = PickupName.Trim(),
                PickupSuburb = PickupSuburb.Trim(),
                DropoffName = DropoffName.Trim(),
                DropoffSuburb = DropoffSuburb.Trim(),
            };
        }
    }
}
