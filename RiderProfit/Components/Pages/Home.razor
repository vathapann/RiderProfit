@page "/"
@* The first page to start with (Welcome page) when the user is not logged in. This page is accessible to all users, regardless of their authentication status. *@

<PageTitle>Home</PageTitle>
<AuthorizeView>
    <Authorized>
        <h1>Hello @context.User.Identity?.Name!</h1>
        <p>Welcome to RiderProfit App!</p>
    </Authorized>
    <NotAuthorized>
        <p>Please log in to access the RiderProfit App.</p>
    </NotAuthorized>
</AuthorizeView>
