@page "/expense-tracking"
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@using System.ComponentModel.DataAnnotations
@using System.Security.Claims
@* Service that load and save rider's data *@
@inject IExpenseService ExpenseService


<PageTitle>Expense Tracking</PageTitle>

<h1>Expense Tracking</h1>

@if (expenses == null)
{
    <p><em>Loading...</em></p>
}
else
{   
    <div class="row g-4">
        @* Add exepnse form *@
        <div class="col-lg-4">
            <h2 class="h5">Add an expense</h2>
            <EditForm Model="form" OnValidSubmit="SaveAsync" FormName="add-expense">
                <DataAnnotationsValidator />

                <div class="mb-3">
                    <label for="date" class="form-label">Date</label>
                    <InputDate id="date" class="form-control" @bind-Value="form.Date" />
                </div>
                
                <div class="mb-3">
                    <label for="category" class="form-label">Category</label>
                    <InputSelect id="category" class="form-select" @bind-Value="form.Category">
                        @foreach(var c in Enum.GetValues<ExpenseCategory>())
                        {
                            <option value="@c">@c</option>
                        }
                    </InputSelect>
                </div>

                <div class="mb-3">
                    <label for="amount" class="form-label">Amount ($)</label>
                    <InputNumber id="amount" class="form-control" @bind-Value="form.Amount" />
                    <ValidationMessage For="() => form.Amount" class="text-danger" />
                </div>

                <div class="mb-3">
                    <label for="description" class="form-label">Description</label>
                    <InputText id="description" class="form-control" @bind-Value="form.Description" />
                    <ValidationMessage For="() => form.Description" class="text-danger" />
                </div>

                <button type="submit" class="btn btn-primary">Save expense</button>
            </EditForm>
            @if(errorMessage != null)
            {
                <div class="alert alert-danger mt-3" role="alert">@errorMessage</div>
            }
            @if(message != null)
            {
                <div class="alert alert-success mt-3" role="status">@message</div>
            }
        </div>

        @* The rider's expenses, latest first *@
        <div class="col-lg-8">
            <h2 class="h5">My expenses</h2>
            @if(expenses.Count ==0 || expenses == null)
            {
                <p>No expenses yet. Add expense using the form.</p>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-sm table-striped align-middle w-25">
                        <thead>
                            <tr>
                                <th>Date</th>
                                <th>Category</th>
                                <th class="text-end">Amount</th>     
                                <th class="text-center">Description</th>                           
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var expense in expenses)
                            {
                                <tr>
                                    <td>@expense.Date.ToString("dd/MM/yyyy")</td>
                                    <td>@expense.Category</td>
                                    <td class="text-end text-nowrap">@expense.Amount.ToString("C")</td>
                                    <td class="text-center">@expense.Description</td>
                                    
                                </tr>
                            }
                        </tbody>
                    </table>

                </div>
            }

        </div>
    </div>
    
    
}

@code{
    // Provided by AddCascadingAuthenticationState() in Program.cs
    [CascadingParameter]
    private Task<AuthenticationState> AuthState { get; set;} = default!;

    private string? userId; 

    // null while loading; empty list means the rider has no expense yet
    private List<Expense>? expenses; 

    // The object form inputs 
    private ExpenseForm form = new ExpenseForm();
    private string? message; 
    private string? errorMessage;

    protected override async Task OnInitializedAsync()
    {
        var user = (await AuthState).User;
        userId = user.FindFirstValue(ClaimTypes.NameIdentifier);
        if(userId == null)
        {
            return;
        }
        // get data from Service namespace
        expenses = await ExpenseService.GetExpensesAsync(userId);
    }
    // Runs only when all validation on forms pass
    private async Task SaveAsync()
    {
        message = null;
        errorMessage = null;

        if (userId is null)
        {
            return;
        }

        try
        {
            var expense = form.ToExpenses(userId);
            await ExpenseService.AddExpenseAsync(expense);
            message = $"{expense.Amount} expense of {expense.Category} saved.";
            // Fresh form
            form = new ExpenseForm {Category = form.Category};
            expenses = await ExpenseService.GetExpensesAsync(userId);
        }
        catch (Exception)
        {
            errorMessage = "Could not save the expense. Please try again.";
        }
    }

    private class ExpenseForm
    {
        public DateOnly Date {get; set;} = DateOnly.FromDateTime(DateTime.Today);
        public ExpenseCategory Category {get; set;} = ExpenseCategory.Tolls;
        [Required(ErrorMessage = "Enter the amount")]
        [Range(0.01, 100000, ErrorMessage = "Enter an amount between $0.01 and $100,000")]
        public decimal Amount {get; set;}
        [StringLength(200, ErrorMessage = "Descrption cannot be more than 200")]
        public string Description {get; set;} = string.Empty;
        public Expense ToExpenses(string userId)
        {
            return new Expense
            {
                UserId = userId,
                Category = Category,
                Amount = Amount,
                Date = Date.ToDateTime(TimeOnly.MinValue),
                Description = Description.Trim(),
            };
        }
   
    }   

    
   
}