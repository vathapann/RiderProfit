@page "/profit-dashboard"
@rendermode InteractiveServer
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@using System.Linq
@using System.Security.Claims
@using Microsoft.AspNetCore.Components.Authorization
@using RiderProfit.Models
@using RiderProfit.Services
@inject IShiftService ShiftService
@inject IExpenseService ExpenseService
@inject IPlatformService PlatformService
@inject IShiftPredictor Predictor

<PageTitle>Profit Dashboard</PageTitle>
<h1>Profit Dashboard</h1>
<p class="text-muted">Your earnings, expenses and estimated profit from recorded shifts.</p>

@if (loading)
{
    <p>Loading dashboard...</p>
}
else if (errorMessage is not null)
{
    <div class="alert alert-danger">@errorMessage</div>
}
else
{
    <div class="card p-3 mb-4">
        <div class="row g-3 align-items-end">
            <div class="col-md-3">
                <label class="form-label">Date range</label>
                <select class="form-select" @bind="selectedRange">
                    <option value="all">All time</option>
                    <option value="week">This week</option>
                    <option value="month">This month</option>
                    <option value="custom">Custom</option>
                </select>
            </div>
            <div class="col-md-3">
                <label class="form-label">Platform</label>
                <select class="form-select" @bind="selectedPlatform">
                    <option value="0">All platforms</option>
                    @foreach (var platform in platforms)
                    {
                        <option value="@platform.Id">@platform.Name</option>
                    }
                </select>
            </div>
            @if (selectedRange == "custom")
            {
                <div class="col-md-3">
                    <label class="form-label">From</label>
                    <InputDate class="form-control" @bind-Value="startDate" />
                </div>
                <div class="col-md-3">
                    <label class="form-label">To</label>
                    <InputDate class="form-control" @bind-Value="endDate" />
                </div>
            }
        </div>
    </div>

    @if (selectedRange == "custom" && startDate.Date > endDate.Date)
    {
        <div class="alert alert-warning">The From date must be before or equal to the To date.</div>
    }
    else
    {
        <div class="row g-3 mb-4">
            <div class="col-md"><div class="card p-3 h-100"><div class="text-muted small">Net profit (selected period)</div><h3>@Money(NetProfit)</h3></div></div>
            <div class="col-md"><div class="card p-3 h-100"><div class="text-muted small">Profit per hour</div><h3>@Money(ProfitPerHour)</h3></div></div>
            <div class="col-md"><div class="card p-3 h-100"><div class="text-muted small">Total earnings</div><h3>@Money(Earnings)</h3></div></div>
            <div class="col-md"><div class="card p-3 h-100"><div class="text-muted small">Total costs</div><h3>@Money(Costs)</h3></div></div>
            <div class="col-md"><div class="card p-3 h-100"><div class="text-muted small">Number of trips</div><h3>@TripCount</h3></div></div>
        </div>

        @if (selectedPlatform != 0)
        {
            <p class="text-muted small">For a selected platform, only expenses linked to its shifts are included. Unlinked expenses are shown under All platforms.</p>
        }

        <div class="row g-3">
            <div class="col-lg-6">
                <div class="card p-3 h-100">
                    <h5>Profit per hour by platform</h5>
                    @foreach (var platform in VisiblePlatforms)
                    {
                        var rate = Rate(FilteredShifts.Where(s => s.PlatformId == platform.Id).ToList());
                        <div class="mt-3 d-flex justify-content-between"><span>@platform.Name</span><strong>@Money(rate)/hr</strong></div>
                        <div class="progress" style="height:22px"><div class="progress-bar bg-success" style="width:@BarWidth(rate)%"></div></div>
                    }
                </div>
            </div>
            <div class="col-lg-6">
                <div class="card p-3 h-100">
                    <h5>Profit per hour by day of week</h5>
                    @foreach (var day in days)
                    {
                        var rate = Rate(FilteredShifts.Where(s => s.StartTime.DayOfWeek == day).ToList());
                        <div class="mt-2 d-flex justify-content-between"><span>@day</span><strong>@Money(rate)/hr</strong></div>
                        <div class="progress" style="height:16px"><div class="progress-bar" style="width:@BarWidth(rate)%"></div></div>
                    }
                </div>
            </div>
            <div class="col-lg-6">
                <div class="card p-3 h-100">
                    <h5>Profit per hour by time slot</h5>
                    @foreach (var slot in slots)
                    {
                        var rate = Rate(FilteredShifts.Where(s => TimeSlot(s.StartTime) == slot).ToList());
                        <div class="mt-3 d-flex justify-content-between"><span>@slot</span><strong>@Money(rate)/hr</strong></div>
                        <div class="progress" style="height:22px"><div class="progress-bar bg-info" style="width:@BarWidth(rate)%"></div></div>
                    }
                </div>
            </div>
            <div class="col-lg-6">
                <div class="card p-3 h-100">
                    <h5>Net profit over time</h5>
                    @if (DailyProfits.Count == 0)
                    {
                        <p class="text-muted">No recorded data for this filter.</p>
                    }
                    else
                    {
                        <svg viewBox="0 0 500 210" style="width:100%;height:220px" role="img" aria-label="Net profit over time line chart">
                            <line x1="35" y1="175" x2="485" y2="175" stroke="#aaa" />
                            <line x1="35" y1="15" x2="35" y2="175" stroke="#aaa" />
                            <polyline points="@LinePoints" fill="none" stroke="#198754" stroke-width="3" stroke-linejoin="round" />
                            @for (int i = 0; i < DailyProfits.Count; i++)
                            {
                                var x = X(i);
                                var y = Y(DailyProfits[i].Profit);
                                <circle cx="@x" cy="@y" r="4" fill="#198754">
                                    <title>@DailyProfits[i].Date.ToString("dd MMM"): @Money(DailyProfits[i].Profit)</title>
                                </circle>
                            }
                            <text x="35" y="198" font-size="12">@DailyProfits.First().Date.ToString("dd MMM")</text>
                            <text x="445" y="198" font-size="12">@DailyProfits.Last().Date.ToString("dd MMM")</text>
                        </svg>
                    }
                </div>
            </div>
        </div>

        <!-- Hourly ML forecasts are separate from recorded earnings and profit. -->
        <section class="card border-0 shadow-sm mt-4 mb-4" style="border-radius:20px;overflow:hidden;" aria-labelledby="forecast-title">
            <div class="card-body p-4">
                <div class="d-flex flex-wrap justify-content-between align-items-start gap-3 mb-3">
                    <div>
                        <div class="small fw-bold text-primary text-uppercase" style="letter-spacing:.08em;">Machine learning insights</div>
                        <h2 id="forecast-title" class="h4 fw-bold mt-1 mb-1">Hourly earnings forecast</h2>
                        <p class="text-muted mb-0">Predicted earnings per delivery hour for today and tomorrow.</p>
                    </div>
                    <div style="min-width:220px;">
                        <label for="forecast-suburb" class="form-label fw-semibold">Restaurant suburb</label>
                        <select id="forecast-suburb" class="form-select" @bind="predictionSuburb" @bind:after="RefreshForecast" disabled="@(!HasPredictionSuburbs)">
                            @foreach (var suburb in Predictor.KnownSuburbs)
                            {
                                <option value="@suburb">@suburb</option>
                            }
                        </select>
                    </div>
                </div>

                @if (!HasPredictionSuburbs)
                {
                    <div class="alert alert-warning mb-0">No restaurant suburbs are available in the ML model.</div>
                }
                else if (forecastError is not null)
                {
                    <div class="alert alert-warning mb-0">@forecastError</div>
                }
                else
                {
                    <div class="row g-3">
                        @foreach (var forecastDay in new[] { DateTime.Today, DateTime.Today.AddDays(1) })
                        {
                            var hourly = HourlyForecast.Where(p => p.Time.Date == forecastDay.Date).ToList();
                            var best = hourly.OrderByDescending(p => p.Amount).FirstOrDefault();
                            <div class="col-lg-6">
                                <div class="rounded-4 p-3 h-100" style="background:#f4f8fd;border:1px solid #dce6f3;">
                                    <div class="d-flex justify-content-between align-items-start flex-wrap gap-2 mb-2">
                                        <div>
                                            <div class="fw-bold">@((forecastDay.Date == DateTime.Today) ? "Today" : "Tomorrow")</div>
                                            <div class="small text-muted">@forecastDay.ToString("ddd, dd MMM yyyy")</div>
                                        </div>
                                        @if (best is not null)
                                        {
                                            <div class="text-end">
                                                <div class="small text-muted">Best predicted hour</div>
                                                <div class="fw-bold text-success">@best.Time.ToString("HH:mm") · @Money(best.Amount)/hr</div>
                                            </div>
                                        }
                                    </div>
                                    <svg viewBox="0 0 540 240" style="width:100%;height:auto;" role="img" aria-label="Hourly predicted earnings for @forecastDay.ToString("dddd")">
                                        @for (var grid = 0; grid <= 4; grid++)
                                        {
                                            var y = 185 - grid * 40;
                                            <line x1="48" y1="@y" x2="525" y2="@y" stroke="#d8e2ee" stroke-dasharray="4 4" />
                                        }
                                        @for (var hour = 0; hour < 24; hour++)
                                        {
                                            var point = hourly.FirstOrDefault(p => p.Time.Hour == hour);
                                            var amount = point?.Amount ?? 0d;
                                            var height = ForecastScale > 0 ? Math.Max(0, amount) / ForecastScale * 160 : 0;
                                            var x = 54 + hour * 19.5;
                                            var y = 185 - height;
                                            <rect x="@x" y="@y" width="13" height="@height" rx="3" fill="@(best is not null && hour == best.Time.Hour ? "#0f987a" : "#377dcc")">
                                                <title>@forecastDay.ToString("ddd dd MMM") @($"{hour:00}:00"): @Money(amount) per delivery hour</title>
                                            </rect>
                                        }
                                    </svg>
                                    <div class="d-flex justify-content-between small text-muted px-2"><span>00:00</span><span>06:00</span><span>12:00</span><span>18:00</span><span>23:00</span></div>
                                    <div class="small text-muted text-center mt-1">Hour of day · Predicted $/delivery hour</div>
                                </div>
                            </div>
                        }
                    </div>
                    <p class="text-muted small mt-3 mb-0">Estimates use the existing Shift Planner ML model for each hour and the selected restaurant suburb. They are earnings per delivery hour, not net profit or guaranteed income. The model uses limited training data and does not include idle time between orders.</p>
                }
            </div>
        </section>
    }
}

@code {
    [CascadingParameter]
    private Task<AuthenticationState> AuthState { get; set; } = default!;

    private bool loading = true;
    private string? errorMessage;
    private List<Shift> shifts = new();
    private List<Expense> expenses = new();
    private List<Platform> platforms = new();

    private string selectedRange = "all";
    private int selectedPlatform = 0;
    private DateTime startDate = DateTime.Today.AddDays(-7);
    private DateTime endDate = DateTime.Today;

    private string predictionSuburb = string.Empty;
    private string? forecastError;
    private List<HourlyPrediction> HourlyForecast = new();
    private bool HasPredictionSuburbs => Predictor.KnownSuburbs.Any();
    private double ForecastScale => Math.Max(1, Math.Ceiling(HourlyForecast.Select(p => Math.Max(0, p.Amount)).DefaultIfEmpty(0).Max() / 5) * 5);

    private sealed record HourlyPrediction(DateTime Time, double Amount);

    private void RefreshForecast()
    {
        HourlyForecast.Clear();
        forecastError = null;
        if (!HasPredictionSuburbs || string.IsNullOrWhiteSpace(predictionSuburb))
            return;

        try
        {
            var today = DateTime.Today;
            for (var dayOffset = 0; dayOffset < 2; dayOffset++)
            {
                for (var hour = 0; hour < 24; hour++)
                {
                    var time = today.AddDays(dayOffset).AddHours(hour);
                    var prediction = (double)Predictor.Predict(time.DayOfWeek, hour, predictionSuburb);
                    if (double.IsNaN(prediction) || double.IsInfinity(prediction))
                        throw new InvalidOperationException("The ML model returned an invalid prediction.");
                    HourlyForecast.Add(new HourlyPrediction(time, prediction));
                }
            }
        }
        catch (Exception)
        {
            HourlyForecast.Clear();
            forecastError = "Could not generate the hourly forecast. Please check the ML model configuration.";
        }
    }

    private readonly string[] slots = { "Breakfast", "Lunch", "Dinner", "Late night" };
    private readonly DayOfWeek[] days = { DayOfWeek.Monday, DayOfWeek.Tuesday, DayOfWeek.Wednesday, DayOfWeek.Thursday, DayOfWeek.Friday, DayOfWeek.Saturday, DayOfWeek.Sunday };

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var user = (await AuthState).User;
            var userId = user.FindFirstValue(ClaimTypes.NameIdentifier);
            if (string.IsNullOrEmpty(userId))
            {
                errorMessage = "Please log in to view your dashboard.";
                return;
            }

            shifts = await ShiftService.GetShiftsAsync(userId);
            expenses = await ExpenseService.GetExpensesAsync(userId);
            platforms = await PlatformService.GetPlatformsAsync(userId);
            predictionSuburb = Predictor.KnownSuburbs.FirstOrDefault() ?? string.Empty;
            RefreshForecast();
        }
        catch (Exception)
        {
            errorMessage = "Could not load dashboard data. Please try again.";
        }
        finally
        {
            loading = false;
        }
    }

    private DateTime FromDate => selectedRange switch
    {
        "all" => DateTime.MinValue,
        "week" => DateTime.Today.AddDays(-(((int)DateTime.Today.DayOfWeek + 6) % 7)),
        "month" => new DateTime(DateTime.Today.Year, DateTime.Today.Month, 1),
        _ => startDate.Date
    };

    private DateTime ToDate => selectedRange == "all" ? DateTime.MaxValue.Date : selectedRange == "custom" ? endDate.Date : DateTime.Today;

    private List<Shift> FilteredShifts => shifts.Where(s =>
        s.StartTime.Date >= FromDate && s.StartTime.Date <= ToDate &&
        (selectedPlatform == 0 || s.PlatformId == selectedPlatform)).ToList();

    private List<Expense> FilteredExpenses
    {
        get
        {
            var shiftIds = FilteredShifts.Select(s => s.Id).ToHashSet();
            return expenses.Where(e =>
                e.Date.Date >= FromDate && e.Date.Date <= ToDate &&
                (selectedPlatform == 0 || (e.ShiftId.HasValue && shiftIds.Contains(e.ShiftId.Value)))).ToList();
        }
    }

    private List<Platform> VisiblePlatforms => selectedPlatform == 0
        ? platforms
        : platforms.Where(p => p.Id == selectedPlatform).ToList();

    private static decimal RunningCost(Shift shift) =>
        shift.Vehicle is null ? 0m : shift.TotalDistanceKm * shift.Vehicle.CostPerKm();

    private decimal Earnings => FilteredShifts.Sum(s => s.Earnings);
    private decimal Costs => FilteredExpenses.Sum(e => e.Amount) + FilteredShifts.Sum(RunningCost);
    private decimal NetProfit => Earnings - Costs;
    private int TripCount => FilteredShifts.Sum(s => s.TripCount);
    private double WorkingHours => FilteredShifts.Sum(s => Math.Max(0, s.Duration.TotalHours));
    private double ProfitPerHour => WorkingHours == 0 ? 0 : (double)NetProfit / WorkingHours;

    private double Rate(List<Shift> items)
    {
        var hours = items.Sum(s => Math.Max(0, s.Duration.TotalHours));
        if (hours == 0) return 0;

        var ids = items.Select(s => s.Id).ToHashSet();
        var recordedCosts = FilteredExpenses.Where(e => e.ShiftId.HasValue && ids.Contains(e.ShiftId.Value)).Sum(e => e.Amount);
        var vehicleCosts = items.Sum(RunningCost);
        return (double)(items.Sum(s => s.Earnings) - recordedCosts - vehicleCosts) / hours;
    }

    private static string TimeSlot(DateTime time) => time.Hour switch
    {
        >= 5 and < 11 => "Breakfast",
        >= 11 and < 16 => "Lunch",
        >= 16 and < 22 => "Dinner",
        _ => "Late night"
    };

    private string Money(decimal value) => value.ToString("C2", System.Globalization.CultureInfo.GetCultureInfo("en-AU"));
    private string Money(double value) => value.ToString("C2", System.Globalization.CultureInfo.GetCultureInfo("en-AU"));
    private static double BarWidth(double value) => Math.Clamp(value / 30 * 100, 0, 100);

    private List<(DateTime Date, decimal Profit)> DailyProfits
    {
        get
        {
            var dates = FilteredShifts.Select(s => s.StartTime.Date)
                .Concat(FilteredExpenses.Select(e => e.Date.Date))
                .Distinct().OrderBy(d => d).ToList();
            return dates.Select(date =>
            {
                var dayShifts = FilteredShifts.Where(s => s.StartTime.Date == date);
                var earnings = dayShifts.Sum(s => s.Earnings);
                var runningCosts = dayShifts.Sum(RunningCost);
                var recordedCosts = FilteredExpenses.Where(e => e.Date.Date == date).Sum(e => e.Amount);
                return (Date: date, Profit: earnings - runningCosts - recordedCosts);
            }).ToList();
        }
    }

    private double X(int index) => DailyProfits.Count < 2 ? 250 : 35 + index * 450.0 / (DailyProfits.Count - 1);
    private double Y(decimal profit)
    {
        var values = DailyProfits.Select(d => d.Profit).Append(0m).ToList();
        decimal min = values.Min();
        decimal max = values.Max();
        if (min == max) return 95;
        return 175 - (double)((profit - min) / (max - min)) * 150;
    }
    private string LinePoints => string.Join(" ", DailyProfits.Select((d, i) => $"{X(i):0.0},{Y(d.Profit):0.0}"));
}
